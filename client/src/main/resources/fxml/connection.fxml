<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.auction.client.controllers.ConnectionController"
           styleClass="feed-bg" style="-fx-background-color: -bidnow-bg;">

    <VBox alignment="CENTER" spacing="14" styleClass="card" maxWidth="420" maxHeight="420">
        <padding><Insets top="34" right="34" bottom="34" left="34"/></padding>

        <Label text="BidNow" styleClass="nav-logo"/>
        <Label text="KẾT NỐI MÁY CHỦ" styleClass="text-title"/>
        <Label text="Nhập địa chỉ IP/Host và cổng của Server để tiếp tục." styleClass="text-muted" wrapText="true"/>

        <VBox spacing="8" alignment="CENTER_LEFT" maxWidth="320">
            <Label text="Server IP / Host:" styleClass="text-section"/>
            <TextField fx:id="ipField" text="127.0.0.1" promptText="VD: 192.168.1.15 hoặc 0.tcp.ngrok.io"/>

            <Label text="Port:" styleClass="text-section"/>
            <TextField fx:id="portField" text="8080" promptText="VD: 8080"/>
        </VBox>

        <Label fx:id="statusLabel" text="" wrapText="true" style="-fx-text-fill: #ef4444;"/>

        <Button text="Kết Nối" onAction="#handleConnect" maxWidth="Infinity" styleClass="btn-primary"/>
    </VBox>
</StackPane>
