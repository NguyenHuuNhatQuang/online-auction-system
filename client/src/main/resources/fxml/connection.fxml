<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.auction.client.controllers.ConnectionController">

    <padding><Insets top="40" right="40" bottom="40" left="40"/></padding>

    <Label text="KẾT NỐI MÁY CHỦ" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2196F3;"/>

    <Label text="Vui lòng nhập địa chỉ IP của Server để tiếp tục" style="-fx-font-size: 14px; -fx-text-fill: gray;"/>

    <VBox spacing="10" alignment="CENTER_LEFT" maxWidth="300">
        <Label text="Server IP Address:" style="-fx-font-size: 14px;"/>
        <TextField fx:id="ipField" text="127.0.0.1" promptText="Ví dụ: 192.168.1.15" style="-fx-font-size: 14px; -fx-padding: 8px;"/>

        <Label text="Port:" style="-fx-font-size: 14px;"/>
        <TextField fx:id="portField" text="8080" editable="false" style="-fx-font-size: 14px; -fx-padding: 8px; -fx-background-color: #f0f0f0;"/>
    </VBox>

    <Label fx:id="statusLabel" text="" style="-fx-text-fill: red;"/>

    <Button text="Kết Nối" onAction="#handleConnect" prefWidth="300" style="-fx-font-size: 16px; -fx-base: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 10px;"/>
</VBox>