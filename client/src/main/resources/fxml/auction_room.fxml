<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.geometry.Insets?>

<VBox spacing="15.0" alignment="TOP_CENTER" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.auction.client.controllers.AuctionRoomController">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label fx:id="roomTitleLabel" text="Đang tải thông tin..." style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
    <Label fx:id="currentPriceLabel" text="Giá hiện tại: Đang chờ cập nhật..." style="-fx-font-size: 18px; -fx-text-fill: #D32F2F; -fx-font-weight: bold;"/>

    <HBox spacing="10" alignment="CENTER">
        <Label text="\$" style="-fx-font-size: 16px;"/>
        <TextField fx:id="bidAmountField" promptText="Nhập mức giá..." style="-fx-font-size: 14px;"/>
        <Button text="Đặt Giá" onAction="#handlePlaceBid" style="-fx-font-size: 14px; -fx-cursor: hand; -fx-base: #2196F3;"/>
    </HBox>

    <Label text="Lịch sử diễn biến:" style="-fx-font-size: 14px;"/>
    <TextArea fx:id="logArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS" style="-fx-font-family: 'Consolas';"/>

    <Button text="Rời khỏi phòng" onAction="#handleLeaveRoom" style="-fx-font-size: 14px; -fx-cursor: hand;"/>

</VBox>