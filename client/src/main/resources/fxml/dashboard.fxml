<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<VBox spacing="15.0" alignment="TOP_CENTER" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.auction.client.controllers.DashboardController">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label fx:id="welcomeLabel" text="Sảnh Chờ Đấu Giá" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <ListView fx:id="auctionListView" VBox.vgrow="ALWAYS" style="-fx-font-size: 14px;"/>

    <HBox spacing="20" alignment="CENTER">
        <Button fx:id="createAuctionBtn" text="Quản Lý Kho Sản Phẩm" onAction="#handleGoToManageProducts" style="-fx-font-size: 14px; -fx-cursor: hand; -fx-base: #2196F3;"/>
        <Button text="Tham Gia Phiên" onAction="#handleJoinAuction" style="-fx-font-size: 14px; -fx-cursor: hand; -fx-base: #4CAF50;"/>
    </HBox>

</VBox>